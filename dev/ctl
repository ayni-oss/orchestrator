#!/usr/bin/env bash
set -euo pipefail

readonly dev_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly repository_root="$(cd "$dev_directory/.." && pwd)"
readonly scripts="$dev_directory/scripts"
source "$dev_directory/lib/common.sh"
cd "$repository_root"

usage() {
  cat <<'EOF'
Usage: dev/ctl COMMAND [OPTIONS]

PostgreSQL-authoritative local Docker Desktop development:
  secrets                       Create immutable local database-role Secrets
  deploy | redeploy | up        Build and install or upgrade the Slice 1 stack
  check [--expect-empty]        Check PostgreSQL migration and readiness
  status                        Show the release, pods, and retained claims
  cleanup | down                Uninstall resources while preserving database data
  purge NAMESPACE               Permanently delete the owned local namespace
  render CONTROL_PLANE_IMAGE    Render the complete development chart
  dependencies                  Build locked Helm dependencies
  help                          Show this help

Commands always target the docker-desktop context. Override the namespace with
AYNI_ORCHESTRATOR_NAMESPACE. Canonical private-v1 gRPC stays pod-local.
EOF
}

cleanup_release() {
  local context namespace
  context="$(dev_context)"
  namespace="$(dev_namespace)"
  command -v helm >/dev/null 2>&1 || {
    echo "Helm is required to uninstall the local release" >&2
    return 1
  }
  helm uninstall "$DEV_RELEASE_NAME" \
    --kube-context "$context" \
    --namespace "$namespace" \
    --ignore-not-found
}

command="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$command" in
  help | --help | -h)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl help" >&2; exit 2; }
    usage
    ;;
  secrets)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl secrets" >&2; exit 2; }
    "$scripts/configure-development-secrets.sh"
    ;;
  deploy | redeploy | up)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl $command" >&2; exit 2; }
    "$scripts/deploy.sh"
    ;;
  check)
    if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --expect-empty ) ]]; then
      echo "usage: dev/ctl check [--expect-empty]" >&2
      exit 2
    fi
    "$scripts/check.sh" "$@"
    ;;
  status)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl status" >&2; exit 2; }
    context="$(dev_context)"
    namespace="$(dev_namespace)"
    helm status "$DEV_RELEASE_NAME" --kube-context "$context" --namespace "$namespace" || true
    kubectl --context "$context" --namespace "$namespace" get pods,persistentvolumeclaims
    ;;
  cleanup | down)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl $command" >&2; exit 2; }
    cleanup_release
    ;;
  purge)
    namespace="$(dev_namespace)"
    if [[ $# -ne 1 || "$1" != "$namespace" ]]; then
      echo "usage: dev/ctl purge $namespace" >&2
      echo "Type the exact configured namespace to confirm permanent deletion." >&2
      exit 2
    fi
    case "$namespace" in
      ayni-orchestrator-*) ;;
      *) echo "refusing to purge outside the ayni-orchestrator-* prefix" >&2; exit 1 ;;
    esac
    context="$(dev_context)"
    environment_label="$(kubectl --context "$context" get namespace "$namespace" \
      --ignore-not-found -o jsonpath='{.metadata.labels.orchestrator\.ayni\.dev/environment}')"
    if [[ "$environment_label" != local ]]; then
      echo "refusing to purge an absent or non-local namespace" >&2
      exit 1
    fi
    echo "permanently deleting local namespace $namespace, including PostgreSQL data" >&2
    cleanup_release
    kubectl --context "$context" delete namespace "$namespace" --wait=true
    ;;
  render)
    if [[ $# -ne 1 || -z "$1" || "$1" =~ [[:space:]] || "$1" == *','* ]]; then
      echo "usage: dev/ctl render CONTROL_PLANE_IMAGE" >&2
      exit 2
    fi
    dev_build_chart_dependencies
    helm template "$DEV_RELEASE_NAME" "$DEV_CHART" \
      --namespace "$(dev_namespace)" \
      --set-string "ayni-orchestrator.images.controlPlane=$1"
    ;;
  dependencies)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl dependencies" >&2; exit 2; }
    dev_build_chart_dependencies
    ;;
  *)
    echo "unknown development command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
