#!/usr/bin/env bash
set -euo pipefail

readonly dev_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly repository_root="$(cd "$dev_directory/.." && pwd)"
readonly scripts="$dev_directory/scripts"
source "$dev_directory/lib/common.sh"
cd "$repository_root"

usage() {
  cat <<'EOF'
Usage: dev/ctl COMMAND [OPTIONS]

Durable-workflow local Docker Desktop development:
  secrets                       Create immutable database and broker role Secrets
  deploy | redeploy | up        Build and install or upgrade the Slice 3 stack
  check [--expect-empty]        Check migrations, streams, and workload readiness
  web [PORT]                    Build and open the project workspace (default 3000)
  console [PORT]                Open the local contributor gateway (default 3000)
  prepare-task verify CHECKOUT SELECTION_JSON FROZEN_REQUEST_JSON
  prepare-task submit FROZEN_REQUEST_JSON
  prepare-task start CHECKOUT FROZEN_REQUEST_JSON FROZEN_START_JSON
  prepare-task submit-start FROZEN_START_JSON
                                Verify source evidence or authorize task preparation
  scenario                      Run the message-to-scripted-response diagnostic
  publish-task prepare SELECTION_JSON FROZEN_JSON
  publish-task submit FROZEN_JSON
  publish-task cancel CANCEL_JSON
                                Review and authorize exact draft publication
  self-development ABSOLUTE_DIRECTORY DIGEST_PINNED_RUNTIME_IMAGE
                                Exercise own source with managed quality and local draft fixture
  quality-runtime               Build/load the local managed task-quality fixture
  acceptance ABSOLUTE_DIRECTORY [--plans-only|--tasks-only|--coding-only|--quality-only|--publication-only|--m4|--m6|--m8]
                                Run cumulative gates or scoped plan/task recovery
  status                        Show the release, pods, and retained claims
  cleanup | down                Uninstall while preserving authoritative stores
  purge NAMESPACE               Permanently delete the owned local namespace
  render CONTROL_IMAGE EXECUTOR_IMAGE
                                Render the complete development chart
  dependencies                  Build locked Helm dependencies
  help                          Show this help

Commands always target the docker-desktop context. Override the namespace with
AYNI_ORCHESTRATOR_NAMESPACE. Canonical private-v1 gRPC stays pod-local.
EOF
}

cleanup_release() {
  local context namespace
  context="$(dev_context)"
  namespace="$(dev_namespace)"
  command -v helm >/dev/null 2>&1 || {
    echo "Helm is required to uninstall the local release" >&2
    return 1
  }
  local session_namespace owner
  session_namespace="${namespace}-sessions"
  owner="$(kubectl --context "$context" get namespace "$session_namespace" \
    --ignore-not-found -o jsonpath='{.metadata.labels.build\.ayni/parent-namespace}')"
  if [[ -n "$owner" && "$owner" != "$namespace" ]]; then
    echo "refusing to stop sessions in a namespace owned by another release" >&2
    return 1
  fi
  helm uninstall "$DEV_RELEASE_NAME" \
    --kube-context "$context" \
    --namespace "$namespace" \
    --ignore-not-found
  if [[ "$owner" == "$namespace" ]]; then
    kubectl --context "$context" --namespace "$session_namespace" delete pod \
      --selector 'app.kubernetes.io/name in (ayni-conversation-session,ayni-task-worker)' --ignore-not-found --wait=true
  fi
}

command="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$command" in
  help | --help | -h)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl help" >&2; exit 2; }
    usage
    ;;
  secrets)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl secrets" >&2; exit 2; }
    "$scripts/configure-development-secrets.sh"
    ;;
  deploy | redeploy | up)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl $command" >&2; exit 2; }
    "$scripts/deploy.sh"
    ;;
  check)
    if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --expect-empty ) ]]; then
      echo "usage: dev/ctl check [--expect-empty]" >&2
      exit 2
    fi
    "$scripts/check.sh" "$@"
    ;;
  self-development)
    "$scripts/self-development-acceptance.sh" "$@"
    ;;
  quality-runtime)
    "$scripts/quality-runtime.sh" "$@"
    ;;
  publish-task)
    "$scripts/publish-task.sh" "$@"
    ;;
  prepare-task)
    "$scripts/prepare-task.sh" "$@"
    ;;
  web)
    [[ $# -le 1 ]] || { echo "usage: dev/ctl web [PORT]" >&2; exit 2; }
    pnpm web:build
    "$scripts/console.sh" "${1:-3000}" "$repository_root/apps/web/build"
    ;;
  console)
    [[ $# -le 1 ]] || { echo "usage: dev/ctl console [PORT]" >&2; exit 2; }
    "$scripts/console.sh" "$@"
    ;;
  scenario)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl scenario" >&2; exit 2; }
    context="$(dev_context)"
    namespace="$(dev_namespace)"
    pod="$(kubectl --context "$context" --namespace "$namespace" get pods \
      -l app.kubernetes.io/name=ayni-orchestrator-control-plane \
      -o jsonpath='{.items[0].metadata.name}')"
    kubectl --context "$context" --namespace "$namespace" exec "$pod" \
      --container control-plane -- /usr/local/bin/workflow-diagnostic \
      --endpoint http://127.0.0.1:50051
    ;;
  acceptance)
    "$scripts/acceptance.sh" "$@"
    ;;
  status)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl status" >&2; exit 2; }
    context="$(dev_context)"
    namespace="$(dev_namespace)"
    helm status "$DEV_RELEASE_NAME" --kube-context "$context" --namespace "$namespace" || true
    kubectl --context "$context" --namespace "$namespace" get pods,persistentvolumeclaims
    ;;
  cleanup | down)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl $command" >&2; exit 2; }
    cleanup_release
    ;;
  purge)
    namespace="$(dev_namespace)"
    if [[ $# -ne 1 || "$1" != "$namespace" ]]; then
      echo "usage: dev/ctl purge $namespace" >&2
      echo "Type the exact configured namespace to confirm permanent deletion." >&2
      exit 2
    fi
    case "$namespace" in
      ayni-orchestrator-*) ;;
      *) echo "refusing to purge outside the ayni-orchestrator-* prefix" >&2; exit 1 ;;
    esac
    context="$(dev_context)"
    environment_label="$(kubectl --context "$context" get namespace "$namespace" \
      --ignore-not-found -o jsonpath='{.metadata.labels.orchestrator\.ayni\.dev/environment}')"
    if [[ "$environment_label" != local ]]; then
      echo "refusing to purge an absent or non-local namespace" >&2
      exit 1
    fi
    echo "permanently deleting local namespace $namespace, including PostgreSQL, JetStream, and executor data" >&2
    cleanup_release
    session_namespace="${namespace}-sessions"
    session_owner="$(kubectl --context "$context" get namespace "$session_namespace" \
      --ignore-not-found -o jsonpath='{.metadata.labels.build\.ayni/parent-namespace}')"
    if [[ -n "$session_owner" && "$session_owner" != "$namespace" ]]; then
      echo "refusing to purge sessions owned by another release" >&2
      exit 1
    fi
    if [[ "$session_owner" == "$namespace" ]]; then
      kubectl --context "$context" delete namespace "$session_namespace" --wait=true
    fi
    kubectl --context "$context" delete namespace "$namespace" --wait=true
    ;;
  render)
    if [[ $# -ne 2 || -z "$1" || -z "$2" || "$1" =~ [[:space:]] || "$2" =~ [[:space:]] || "$1" == *','* || "$2" == *','* ]]; then
      echo "usage: dev/ctl render CONTROL_IMAGE EXECUTOR_IMAGE" >&2
      exit 2
    fi
    dev_build_chart_dependencies
    helm template "$DEV_RELEASE_NAME" "$DEV_CHART" \
      --namespace "$(dev_namespace)" \
      --set-string "ayni-orchestrator.images.controlPlane=$1" \
      --set-string "ayni-orchestrator.images.scriptedExecutor=$2"
    ;;
  dependencies)
    [[ $# -eq 0 ]] || { echo "usage: dev/ctl dependencies" >&2; exit 2; }
    dev_build_chart_dependencies
    ;;
  *)
    echo "unknown development command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
