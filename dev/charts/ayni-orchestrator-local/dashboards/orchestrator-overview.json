          "editorMode": "code",
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"__AYNI_NAMESPACE__\"} or (label_replace(container_fs_usage_bytes{job=\"ayni-orchestrator-node-storage\",id=\"/\"}, \"persistentvolumeclaim\", \"docker-desktop-root\", \"device\", \".*\") unless on() (count(kubelet_volume_stats_used_bytes{namespace=\"__AYNI_NAMESPACE__\"}) > 0))",
