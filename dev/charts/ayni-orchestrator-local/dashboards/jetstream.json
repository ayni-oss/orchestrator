{
  "uid": "ayni-orchestrator-jetstream",
  "title": "Event Delivery",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "ayni",
    "jetstream"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Broker and exporter health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "description": "Exporter reachable and NATS monitoring reports a healthy broker.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"ayni-orchestrator-jetstream\"} * on(job, instance) group_left(value) gnatsd_healthz_status_value{value=\"ok\"}",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "JetStream enabled",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "description": "Broker reports JetStream enabled.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - jetstream_server_jetstream_disabled",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "Broker stored bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "description": "Logical stored message bytes; PVC usage also includes metadata and filesystem overhead.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_server_total_message_bytes",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "Broker storage budget",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "description": "Configured server file-storage ceiling.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_server_max_storage",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "title": "Lifecycle stored messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "description": "Messages within the bounded replay window; this is not unpublished database work.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_stream_total_messages{stream_name=\"ORCHESTRATOR_LIFECYCLE\"}",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "title": "Lifecycle storage occupancy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "description": "Stream logical storage. Full streams reject new publications; age expiry removes old messages.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_stream_total_bytes{stream_name=\"ORCHESTRATOR_LIFECYCLE\"} / jetstream_stream_limit_bytes{stream_name=\"ORCHESTRATOR_LIFECYCLE\"}",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "title": "Consumer pending messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "description": "Populates when D3 creates durable consumers; no consumer is provisioned in D1.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_consumer_num_pending",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 8,
      "title": "Consumer unacknowledged messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jetstream_consumer_num_ack_pending",
          "legendFormat": "{{stream_name}} {{consumer_name}}",
          "range": true
        }
      ],
      "options": {}
    },
    {
      "id": 9,
      "title": "Pending accepted events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "orchestrator_verification_outbox_pending",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {}
    },
    {
      "id": 10,
      "title": "Pending event bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "orchestrator_verification_outbox_pending_bytes",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {}
    },
    {
      "id": 11,
      "title": "Oldest pending event age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "orchestrator_verification_outbox_oldest_pending_age_seconds",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {}
    },
    {
      "id": 12,
      "title": "Publication outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(orchestrator_verification_outbox_publications_total[5m]))",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {}
    },
    {
      "id": 13,
      "title": "Retained published decisions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "description": "Populates when consumers exist; application commit must precede acknowledgement.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "orchestrator_verification_outbox_retained_published",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {}
    },
    {
      "id": 14,
      "title": "Verification consumer pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "orchestrator_verification_consumer_pending",
          "refId": "A",
          "legendFormat": "Verification consumer pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Verification consumer awaiting ACK",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "orchestrator_verification_consumer_unacknowledged",
          "refId": "A",
          "legendFormat": "Verification consumer awaiting ACK"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Verification consumer handling outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 56,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(orchestrator_verification_consumer_deliveries_total[5m])",
          "refId": "A",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "System Overview",
      "type": "link",
      "url": "/d/ayni-orchestrator-tasks-resources",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Execution Traces",
      "type": "link",
      "url": "/d/ayni-orchestrator-traces",
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Event Delivery",
      "type": "link",
      "url": "/d/ayni-orchestrator-jetstream",
      "includeVars": false,
      "keepTime": true
    }
  ]
}
