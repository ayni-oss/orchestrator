{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ayni-orchestrator",
    "observability",
    "prometheus",
    "kube-state-metrics",
    "grafana"
  ],
  "properties": {
    "ayni-orchestrator": {
      "type": "object"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "prometheus": {
      "type": "object"
    },
    "kube-state-metrics": {
      "type": "object"
    },
    "grafana": {
      "type": "object"
    }
  }
}
