{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ayni-orchestrator", "postgres"],
  "properties": {
    "ayni-orchestrator": { "type": "object" },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "serviceName", "storage", "secrets", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "const": "postgres:17.6-bookworm@sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3" },
        "serviceName": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admin", "migrator", "runtime"],
          "properties": {
            "admin": { "type": "string", "minLength": 1 },
            "migrator": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "type": "object" }
      }
    }
  }
}
