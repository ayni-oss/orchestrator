{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ayni-orchestrator",
    "observability",
    "prometheus",
    "grafana",
    "jetstream"
  ],
  "properties": {
    "ayni-orchestrator": {
      "type": "object"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "collectorImage",
        "jaegerImage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectorImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "jaegerImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "prometheus": {
      "type": "object"
    },
    "grafana": {
      "type": "object"
    },
    "jetstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "serverImage",
        "toolingImage",
        "exporterImage",
        "storageClassName",
        "storageSize",
        "maxFileBytes",
        "lifecycle"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serverImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "toolingImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "exporterImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "storageClassName": {
          "type": "string"
        },
        "storageSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1073741824
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes",
            "maxMessages",
            "maxAgeSeconds",
            "duplicateWindowSeconds",
            "maxConsumers"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "maxMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "maxAgeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            },
            "duplicateWindowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxConsumers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        }
      }
    }
  }
}
