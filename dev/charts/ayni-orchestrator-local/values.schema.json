{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ayni-orchestrator",
    "observability",
    "prometheus",
    "grafana"
  ],
  "properties": {
    "ayni-orchestrator": {
      "type": "object"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "collectorImage",
        "jaegerImage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectorImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "jaegerImage": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "prometheus": {
      "type": "object"
    },
    "grafana": {
      "type": "object"
    }
  }
}
