# Local development settings. Copy to .env and do not commit it.
# The bootstrap script reads these values to create local Kubernetes Secrets.

# Optional administrator GitHub App. Leave ID/key empty to onboard through UI.
# Set Helm connections.githubAppSecretName=github-app-credentials to register it.
# GitHub App identifier (not secret).
GITHUB_APP_ID=

# GitHub App installation identifier (not secret; submitted through the binding API).
GITHUB_APP_INSTALLATION_ID=

# The downloaded PEM, encoded to one base64 line for dotenv convenience.
# Base64 is not encryption; keep this local file private.
# macOS: base64 -i private-key.pem | tr -d '\n'
# Linux: base64 -w 0 private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

# Optional OpenAI API key used by the coding and PR-author agents.
OPENAI_API_KEY=

# Optional Ayni environment producer credentials for dedicated Kubernetes builds.
# The signing seed is 32 bytes encoded as 64 lowercase hex characters.
# The key ID must match the public key's ID pinned in the repository's .ayni.toml.
# Store only in this mode-600 file; do not put it in Helm values or commit it.
AYNI_ENV_CERTIFICATE_SIGNING_KEY=
AYNI_ENV_CERTIFICATE_KEY_ID=

# Optional registry credentials for private GHCR runtime images.
# Use a classic personal access token with read:packages. The bootstrap creates
# the Kubernetes imagePullSecret named runtime-pull; do not commit real values.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=
