# Local development settings. Copy to .env and do not commit it.
# The bootstrap script reads these values to create local Kubernetes Secrets.

# GitHub App identifier (not secret).
GITHUB_APP_ID=

# GitHub App installation identifier (not secret; submitted through the binding API).
GITHUB_APP_INSTALLATION_ID=

# The downloaded PEM, encoded to one base64 line for dotenv convenience.
# Base64 is not encryption; keep this local file private.
# macOS: base64 -i private-key.pem | tr -d '\n'
# Linux: base64 -w 0 private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

# OpenAI API key used by the coding and PR-author agents.
OPENAI_API_KEY=
