{
  "name": "ORCHESTRATOR_WORKFLOW_COMMAND_V1",
  "description": "M1 application-to-executor commands; PostgreSQL remains authoritative",
  "subjects": ["orchestrator.workflow.command.conversation.v1"],
  "retention": "limits",
  "storage": "file",
  "num_replicas": 1,
  "discard": "new",
