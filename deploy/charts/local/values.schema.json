{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["ayni-orchestrator", "observability", "prometheus", "kube-state-metrics", "grafana", "fixtures"],
  "properties": {
    "ayni-orchestrator": { "type": "object" },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "prometheus": { "type": "object" },
    "kube-state-metrics": { "type": "object" },
    "grafana": { "type": "object" },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerImage", "imagePullPolicy", "managedCheck", "artifactRejection", "repositoryUrl", "revision", "lockSha256", "ayniVersion"],
      "properties": {
        "workerImage": { "$ref": "#/definitions/image" },
        "imagePullPolicy": { "enum": ["Never", "IfNotPresent", "Always"] },
        "managedCheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "createEvidenceClaim", "evidenceSize"],
          "properties": {
            "enabled": { "type": "boolean" },
            "createEvidenceClaim": { "type": "boolean" },
            "evidenceSize": { "$ref": "#/definitions/quantity" }
          }
        },
        "artifactRejection": { "$ref": "#/definitions/toggle" },
        "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ayniVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "fixtures": {
            "properties": {
              "managedCheck": { "properties": { "enabled": { "const": true } } },
              "artifactRejection": { "properties": { "enabled": { "const": true } } }
            }
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "ayni-orchestrator": { "properties": { "enabled": { "const": true } } },
          "fixtures": {
            "properties": {
              "managedCheck": {
                "properties": {
                  "enabled": { "const": true },
                  "createEvidenceClaim": { "const": true }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "image": { "type": "string", "pattern": "^[^\\s,]+$", "minLength": 1 },
    "quantity": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:m|n|u|Ki|Mi|Gi|Ti|Pi|Ei)?$" },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
