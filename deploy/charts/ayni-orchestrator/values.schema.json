{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "images", "development", "controlPlane", "web", "persistence", "customClients"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "workerImage", "outputClaim", "outputSize", "modelSecret", "intervalSeconds", "requestTimeoutSeconds", "concurrency", "profiles"],
      "properties": {
        "enabled": { "type": "boolean" },
        "workerImage": { "type": "string" },
        "outputClaim": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "outputSize": { "$ref": "#/definitions/quantity" },
        "modelSecret": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "intervalSeconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
        "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "allowEmulation": { "type": "boolean" },
        "profiles": { "type": "object", "maxProperties": 128 },
        "managedRuntime": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "platform": { "enum": ["linux/amd64", "linux/arm64"] },
            "service_account": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
            "pull_secret": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
            "assessment": { "type": "object" }
          },
          "required": ["platform"]
        }
        ,"serviceAccounts": {
          "type": "object", "additionalProperties": false, "required": ["create", "imagePullSecrets"],
          "properties": { "create": { "type": "boolean" }, "imagePullSecrets": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 } } } } }
        }
      }
    },
    "global": { "type": "object" },
    "enabled": { "type": "boolean" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "web", "pullPolicy"],
      "properties": {
        "controlPlane": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "pullPolicy": { "enum": ["Never", "IfNotPresent", "Always"] }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hotReload"],
      "properties": {
        "hotReload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "resources"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources"],
      "properties": { "resources": { "$ref": "#/definitions/resources" } }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlaneState"],
      "properties": {
        "controlPlaneState": { "$ref": "#/definitions/claim" }
      }
    },
    "customClients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253 }
      }
    }
  },
  "definitions": {
    "image": { "type": "string", "pattern": "^[^\\s,]+$", "minLength": 1 },
    "quantity": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:m|n|u|Ki|Mi|Gi|Ti|Pi|Ei)?$" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": { "size": { "$ref": "#/definitions/quantity" } }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemory" },
        "limits": { "$ref": "#/definitions/cpuMemory" }
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    }
  }
}
