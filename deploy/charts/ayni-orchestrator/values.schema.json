{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "images",
    "development",
    "controlPlane",
    "web",
    "persistence",
    "customClients"
  ],
  "properties": {
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubAppSecretName",
        "testImage"
      ],
      "properties": {
        "githubAppSecretName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "testImage": {
          "type": "string",
          "pattern": "^$|^[^ ]+@sha256:[a-f0-9]{64}$"
        },
        "adminCertificates": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "displayName",
              "secretName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "secretName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        },
        "adminRegistries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "displayName",
              "imageNamespace",
              "username",
              "pullSecretName",
              "pushSecretName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "imageNamespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "pullSecretName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "pushSecretName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "workerImage",
        "outputClaim",
        "outputSize",
        "modelSecret",
        "intervalSeconds",
        "requestTimeoutSeconds",
        "codingTurns",
        "qualityRepairLimit",
        "concurrency",
        "profiles"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workerImage": {
          "type": "string"
        },
        "outputClaim": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "outputSize": {
          "$ref": "#/definitions/quantity"
        },
        "modelSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "codingTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "qualityRepairLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "allowEmulation": {
          "type": "boolean"
        },
        "profiles": {
          "type": "object",
          "maxProperties": 128
        },
        "managedRuntime": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "platform": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ]
            },
            "build": {
              "$ref": "#/definitions/buildRuntime"
            },
            "registry_prefix": {
              "type": "string",
              "maxLength": 256
            },
            "service_account": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            },
            "pull_secret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            }
          },
          "required": [
            "platform"
          ]
        },
        "serviceAccounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "imagePullSecrets"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "imagePullSecrets": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "maxLength": 63
                  }
                }
              }
            }
          }
        },
        "engineMode": {
          "enum": [
            "external-isolated",
            "local-development",
            "dedicated-builder"
          ],
          "default": "external-isolated"
        },
        "reporting": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "endpoint",
            "source"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https?://[^@?# ]+/events/verification$"
            },
            "source": {
              "type": "string",
              "pattern": "^ayni://orchestrator/supervisors/[A-Za-z0-9_-]{1,128}$"
            }
          }
        },
        "verificationMode": {
          "type": "string",
          "enum": [
            "shadow",
            "events"
          ],
          "default": "shadow"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verificationMode": {
                "const": "events"
              }
            },
            "required": [
              "verificationMode"
            ]
          },
          "then": {
            "properties": {
              "reporting": {
                "type": "object"
              }
            },
            "required": [
              "reporting"
            ]
          }
        }
      ]
    },
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "web",
        "pullPolicy"
      ],
      "properties": {
        "controlPlane": {
          "$ref": "#/definitions/image"
        },
        "web": {
          "$ref": "#/definitions/image"
        },
        "pullPolicy": {
          "enum": [
            "Never",
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hotReload"
      ],
      "properties": {
        "hotReload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "resources"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlaneState"
      ],
      "properties": {
        "controlPlaneState": {
          "$ref": "#/definitions/claim"
        }
      }
    },
    "customClients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "secretName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracesEndpoint",
        "endpointConfigMap"
      ],
      "properties": {
        "tracesEndpoint": {
          "type": "string",
          "pattern": "^(|https?://[^\\s@?#]+)$"
        },
        "endpointConfigMap": {
          "type": "string",
          "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$"
        }
      }
    },
    "outbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "natsUrl",
        "localDevelopment"
      ],
      "properties": {
        "natsUrl": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^$|^nats://[a-zA-Z0-9.-]+:[1-9][0-9]{0,4}/?$"
        },
        "localDevelopment": {
          "type": "boolean"
        },
        "consumerEnabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "natsUrl": {
                "minLength": 1
              }
            }
          },
          "then": {
            "properties": {
              "localDevelopment": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "buildRuntime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [],
      "properties": {
        "service_account": {
          "type": "string",
          "maxLength": 63
        },
        "registry_secret": {
          "type": "string",
          "maxLength": 63
        },
        "signing_secret": {
          "type": "string",
          "maxLength": 63
        },
        "engine_secret": {
          "type": "string",
          "maxLength": 63
        },
        "engine_host": {
          "type": "string",
          "pattern": "^$|^tcp://[A-Za-z0-9.-]+:2376$"
        },
        "isolated_engine": {
          "type": "boolean",
          "default": false
        },
        "engine": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "image",
            "security_mode"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[^ ]+@sha256:[a-f0-9]{64}$"
            },
            "security_mode": {
              "enum": [
                "local-development",
                "dedicated-builder"
              ]
            }
          }
        },
        "configuration_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^[^\\s,]+$",
      "minLength": 1
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:m|n|u|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/cpuMemory"
        },
        "limits": {
          "$ref": "#/definitions/cpuMemory"
        }
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/definitions/quantity"
        },
        "memory": {
          "$ref": "#/definitions/quantity"
        }
      }
    }
  }
}
