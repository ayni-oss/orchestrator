{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "images",
    "workflowPostgres",
    "workflowJetstream",
    "scriptedExecutor",
    "controlPlane",
    "providers"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "scriptedExecutor",
        "pullPolicy"
      ],
      "properties": {
        "controlPlane": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openai",
            "sessionAuthoritySecretName"
          ],
          "properties": {
            "sessionAuthoritySecretName": {
              "type": "string",
              "minLength": 1
            },
            "openai": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "baseUrl",
                "fixtureEgress"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "baseUrl": {
                  "type": "string",
                  "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$"
                },
                "fixtureEgress": {
                  "type": "boolean"
                }
              }
            },
            "anthropic": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "baseUrl",
                "fixtureEgress"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "baseUrl": {
                  "type": "string",
                  "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$"
                },
                "fixtureEgress": {
                  "type": "boolean"
                }
              }
            },
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "egress"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "egress": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "to",
                      "ports"
                    ],
                    "properties": {
                      "to": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": "object"
                        }
                      },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "scriptedExecutor": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "workflowPostgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migratorSecretName",
        "runtimeSecretName",
        "runtimeRoleName"
      ],
      "properties": {
        "migratorSecretName": {
          "type": "string",
          "minLength": 1
        },
        "runtimeSecretName": {
          "type": "string",
          "minLength": 1
        },
        "runtimeRoleName": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        }
      }
    },
    "workflowJetstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "username",
        "applicationSecretName",
        "executorUsername",
        "executorSecretName"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^nats://"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,128}$"
        },
        "applicationSecretName": {
          "type": "string",
          "minLength": 1
        },
        "executorUsername": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,128}$"
        },
        "executorSecretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai",
        "sessionAuthoritySecretName"
      ],
      "properties": {
        "sessionAuthoritySecretName": {
          "type": "string",
          "minLength": 1
        },
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "baseUrl",
            "fixtureEgress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$"
            },
            "fixtureEgress": {
              "type": "boolean"
            }
          }
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "baseUrl",
            "fixtureEgress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$"
            },
            "fixtureEgress": {
              "type": "boolean"
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "egress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "egress": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "to",
                  "ports"
                ],
                "properties": {
                  "to": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "object"
                    }
                  },
                  "ports": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scriptedExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "resources"
      ],
      "properties": {
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "httpPort",
        "trustedGrpcPort",
        "resources"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "trustedGrpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "taskExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "fixtureEnabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fixtureEnabled": {
          "type": "boolean"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "workspaceId",
        "repository",
        "authoritySecretName",
        "githubSecretName",
        "fixtureEnabled",
        "fixtureApiUrl",
        "fixtureGitUrl"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workspaceId": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "authoritySecretName": {
          "type": "string"
        },
        "githubSecretName": {
          "type": "string"
        },
        "fixtureEnabled": {
          "type": "boolean"
        },
        "fixtureApiUrl": {
          "type": "string"
        },
        "fixtureGitUrl": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "workspaceId": {
                "pattern": "^[a-f0-9-]{36}$"
              },
              "repository": {
                "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
              },
              "authoritySecretName": {
                "minLength": 1
              },
              "githubSecretName": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
