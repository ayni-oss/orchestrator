# syntax=docker/dockerfile:1.7
FROM rust:1.94.0-alpine3.23@sha256:ff0adc35894eb79586ce752a1b5a9eadc88b938c56d8f2b4b537b6258ff3fa10 AS builder
RUN apk add --no-cache build-base musl-dev binutils git
WORKDIR /workspace
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY tools ./tools
COPY backend ./backend
COPY proto ./proto
COPY dev/fixtures/task-source ./dev/fixtures/task-source
COPY dev/fixtures/task-quality ./dev/fixtures/task-quality
COPY dev/fixtures/runtime-preparation ./dev/fixtures/runtime-preparation
RUN rustc --edition=2024 tools/bootstrap/src/bin/image-build.rs -o /usr/local/bin/image-build
ARG KEEP_TARGET_CACHE=false
RUN --mount=type=cache,id=ayni-runtime-preparation-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=ayni-runtime-preparation-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=ayni-runtime-preparation-target,target=/workspace/target \
    /usr/local/bin/image-build runtime
FROM scratch AS binaries
COPY --from=builder /output/ /
