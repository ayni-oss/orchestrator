{
  "name": "@ayni-orchestrator/workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "workspaces": [
    "apps/*",
    "clients/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "chart:check": "scripts/ci/check-helm.sh",
    "proto:check": "scripts/ci/check-proto.sh",
    "proto:generate": "buf generate",
    "typecheck": "pnpm --filter @ayni-orchestrator/grpc-bindings check && pnpm --filter @ayni-orchestrator/bff check && pnpm --filter @ayni-orchestrator/web check",
    "test:frontend": "pnpm --filter @ayni-orchestrator/bff test && pnpm --filter @ayni-orchestrator/web test",
    "test:e2e": "pnpm --filter @ayni-orchestrator/web test:e2e",
    "build:web": "pnpm --filter @ayni-orchestrator/web build",
    "check:browser-bundle": "pnpm --filter @ayni-orchestrator/web check:browser-bundle",
    "frontend:check": "pnpm typecheck && pnpm build:web && pnpm check:browser-bundle",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "python3 scripts/ci/check-docs.py && pnpm docs:build && python3 scripts/ci/check-docs-site.py"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "0.2.0",
    "mermaid": "11.17.2",
    "vitepress": "1.6.3",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.43"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "6.4.3"
    }
  }
}
