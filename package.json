{
  "name": "@ayni-orchestrator/workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "workspaces": [
    "clients/*",
    "apps/web"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "chart:check": "cargo xtask check charts",
    "proto:check": "cargo xtask check protocol",
    "proto:generate": "buf generate",
    "typecheck": "pnpm --filter @ayni-orchestrator/grpc-bindings check && pnpm --filter @ayni-orchestrator/web check",
    "test": "pnpm --filter @ayni-orchestrator/grpc-bindings test && pnpm --filter @ayni-orchestrator/web test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "cargo xtask check docs && node --test docs/.vitepress/theme/tests/mermaid-runtime.test.mjs && pnpm docs:build && cargo xtask check docs-site",
    "web:dev": "pnpm --filter @ayni-orchestrator/web dev",
    "web:build": "pnpm --filter @ayni-orchestrator/web build"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "0.2.0",
    "mermaid": "11.17.2",
    "playwright": "1.62.1",
    "vitepress": "1.6.3",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.43"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "6.4.3",
      "source-map-js": "1.2.2",
      "mermaid>katex": "0.18.2"
    }
  }
}
