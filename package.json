{
  "name": "@ayni-orchestrator/workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "workspaces": [
    "clients/*",
    "dev/live-ui"
  ],
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "chart:check": "scripts/ci/check-helm.sh",
    "proto:check": "scripts/ci/check-proto.sh",
    "proto:generate": "buf generate",
    "typecheck": "pnpm --filter @ayni-orchestrator/grpc-bindings check",
    "test": "pnpm --filter @ayni-orchestrator/grpc-bindings test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "python3 scripts/ci/check-docs.py && node --test scripts/ci/test-diagram-initialization.mjs && pnpm docs:build && python3 scripts/ci/check-docs-site.py"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "0.2.0",
    "mermaid": "11.17.2",
    "playwright": "1.62.1",
    "vitepress": "1.6.3",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.43"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "6.4.3",
      "source-map-js": "1.2.2",
      "mermaid>katex": "0.18.2"
    }
  }
}
