# Local M3 credentials template. Copy to .env only for your own tooling; do not commit it.
# The Kubernetes setup reads the equivalent files in .local/secrets/ instead,
# because a GitHub App PEM key is multiline.

# GitHub App identifier (not secret).
M3_GITHUB_APP_ID=

# GitHub App installation identifier (not secret; submitted through the binding API).
M3_GITHUB_INSTALLATION_ID=

# Secret values: leave blank here. Do not paste this file into issue comments,
# terminal transcripts, or Kubernetes manifests.
M3_GITHUB_PRIVATE_KEY=
OPENAI_API_KEY=
M3_PUBLISHER_TOKEN=
