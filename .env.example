# Local bootstrap inputs. Copy to .env only for local tooling; do not commit it.
# These are file paths, not secret values. The application receives secrets only
# through read-only Kubernetes Secret mounts or explicitly injected Job values.

# GitHub App identifier file (the ID is not secret).
GITHUB_APP_ID_FILE=.local/secrets/app-id

# GitHub App installation identifier (not secret; submitted through the binding API).
GITHUB_APP_INSTALLATION_ID=

# Do not put PEM, API keys, tokens, or base64-encoded credentials in this file.
# Base64 is an encoding, not protection.
GITHUB_APP_PRIVATE_KEY_FILE=.local/secrets/private-key.pem
OPENAI_API_KEY_FILE=.local/secrets/api-key
DEVELOPMENT_PUBLISH_TOKEN_FILE=.local/secrets/publisher-token
